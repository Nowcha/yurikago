rules_version = '2';

// 設計方針:
// - publicリポ前提のため、防御はこのルールがすべて。認証済み かつ 世帯メンバーのみアクセス可
// - メンバー追加は「相手のUIDを既存メンバーが登録する」方式（招待コード方式はSparkプランで
//   安全に実装できないため不採用。Cloud Functionsを使わない制約による）
// - 世帯は最大2名（夫婦専用）

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    function isMemberAfter(hid) {
      return isSignedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    match /households/{hid} {

      // 作成: 自分自身を含む最大2名のmemberUidsでのみ作成可
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() >= 1
        && request.resource.data.memberUids.size() <= 2;

      // 読み取り: メンバーのみ。
      // クライアントは where('memberUids','array-contains', uid) で自分の世帯を検索する
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.memberUids;

      // 更新: メンバーのみ。memberUidsは2名以下を維持し、自分自身は必ず残す
      // （パートナーのUID追加もこのルールで許可される: 既存メンバーが実行するため）
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() <= 2;

      // 世帯の破棄は「削除」ではなく墓標化する。
      // deleteDoc()はサブコレクションを消さないので、本体だけ消すとtasks/items/recordsが
      // 孤児として残る。その状態では誰でも同じhidで世帯を作り直せ、isMember()が通って
      // 残存データが読めてしまう（エミュレータで再現確認済み）。
      // 墓標が居座ればcreateは「既存ドキュメントへの書き込み」になって成立せず、経路が閉じる。
      // 「すべて削除」が嘘にならないよう、墓標に残せるキーは以下の2つだけに制限する。
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.keys().hasOnly(['memberUids', 'deletedAt'])
        && request.resource.data.memberUids.size() == 0
        && request.resource.data.deletedAt is string;

      // 本体の物理削除は許可しない。墓標を消せると再作成経路が復活するため、
      // memberUidsが空になった時点でこのドキュメントは誰にも触れなくなる（＝墓標は不変）

      // サブコレクション（tasks / items / records）: 世帯メンバーのみ全操作可。
      // createは初回世帯作成バッチ内の親ドキュメントも参照できるようgetAfter()で判定する
      match /{collection}/{docId} {
        allow create: if isMemberAfter(hid);
        allow read, update, delete: if isMember(hid);
      }
    }

    // 上記以外は全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
